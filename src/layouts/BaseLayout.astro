---
import "../styles/global.css";
import "../styles/refinements.css";
import SEO from "../components/SEO.astro";
import SkipLink from "../components/SkipLink.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noIndex?: boolean;
};

const { title, description, canonical, ogImage, ogImageAlt, noIndex } = Astro.props;
---
<!doctype html>
<html lang={Astro.currentLocale ?? "en"}>
  <head>
    <SEO title={title} description={description} canonical={canonical} ogImage={ogImage} ogImageAlt={ogImageAlt} noIndex={noIndex} />
  </head>
  <body>
    <SkipLink />
    <Header />

    <main id="main-content" role="main" tabindex="-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
