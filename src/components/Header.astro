---
import { navState } from '../i18n/localization';
const links = [
  ['/countries/', 'Countries'],
  ['/historical-economics/', 'History & economics'],
  ['/law-and-governance/', 'Law & governance'],
  ['/sonar-and-strandings/', 'Sonar & strandings'],
  ['/when-a-whale-comes-ashore/', 'Whale carcass guide'],
  ['/resources/', 'Resources'],
  ['/about/', 'About'],
];
---
<header class="site-header" role="banner">
  <nav aria-label="Primary" class="container nav-shell">
    <a href="/" class="wordmark" aria-label="Whaling Watch home" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>
      <span class="wordmark-mark" aria-hidden="true">◒</span>
      <span>Whaling <em>Watch</em></span>
    </a>
    <div class="nav-links">{links.map(([href, label]) => <a href={href} aria-current={navState(Astro.url.pathname, href)}>{label}</a>)}</div>
  </nav>
</header>
