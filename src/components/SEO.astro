---
import { SITE } from "@/config/site";
import { equivalents } from "../i18n/localization";
import type { IntroductionLocale } from "../i18n/introductions";

export type Props = {
  title?: string;
  description?: string;
  canonical?: string; // optional explicit canonical
  ogImage?: string;   // absolute or site-relative (/og/og-default.png)
  ogImageAlt?: string;
  noIndex?: boolean;
  locale?: "en" | IntroductionLocale;
};

const {
  title,
  description = SITE.description,
  canonical,
  ogImage = "/og/og-whaling-watch.png",
  ogImageAlt = "Whaling Watch — Independent. International. Source-driven.",
  locale = "en",
  noIndex = false
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, "") ?? SITE.canonicalBase ?? "";
const url = new URL(Astro.url.pathname, site || Astro.url.origin).toString();

const finalTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const finalCanonical = canonical ?? url;

const alternatives = equivalents(Astro.url.pathname);
const ogLocale = { en: "en_US", is: "is_IS", ja: "ja_JP", nb: "nb_NO", 'pt-br': "pt_BR" }[locale];
const ogUrl = finalCanonical;
const ogImg = ogImage.startsWith("http") ? ogImage : (site ? `${site}${ogImage}` : ogImage);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{finalTitle}</title>
<meta name="description" content={description} />
{!noIndex && <link rel="canonical" href={finalCanonical} />}
{!noIndex && alternatives.length > 1 && <>
  {alternatives.map(item => <link rel="alternate" hreflang={item.locale} href={new URL(item.href, site).href} />)}
  <link rel="alternate" hreflang="x-default" href={new URL(alternatives[0].href, site).href} />
</>}

<link rel="icon" href="/whaling-favicon.png" />
<meta name="theme-color" content="#031f36" />

{noIndex ? <meta name="robots" content="noindex,nofollow" /> : null}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={finalTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImg} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={finalTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImg} />
<meta name="twitter:image:alt" content={ogImageAlt} />
