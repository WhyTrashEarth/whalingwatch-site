
---
import LanguageLinks from './LanguageLinks.astro';
import NavigationHeading from './NavigationHeading.astro';
import { navigationGroups } from '../data/navigation';
import { navState } from '../i18n/localization';
import { introductions, type IntroductionLocale } from '../i18n/introductions';
type Props = { locale?: 'en' | IntroductionLocale };
const { locale = 'en' } = Astro.props;
const localized = locale === 'en' ? undefined : introductions[locale];
const localizedLabels: Record<string, string | undefined> = {
  '/about/': localized?.footer.about,
  '/resources/': localized?.ui.resources,
  '/contact/': localized?.ui.contact,
};
---
<footer class="site-footer" role="contentinfo" aria-label={localized?.ui.footer ?? 'Site footer'}>
  <div class="container footer-top">
    <div class="footer-brand">
      <p class="eyebrow">Whaling Watch</p>
      <p class="footer-statement">{localized?.ui.statement ?? 'Independent. International. Source-driven.'}</p>
      <p class="footer-note">{localized?.footer.note ?? 'No petitions. No donation appeals. Just careful context and the sources behind it.'}</p>
    </div>
    <a class="footer-owner" href="https://whytrashearth.org" target="_blank" rel="noopener noreferrer" lang="en">An independent project by WhyTrashEarth ↗</a>
  </div>
  <nav class="container footer-navigation" aria-label="Footer navigation" lang="en">
    {localized && <p class="footer-language-note">Navigation links open pages in English.</p>}
    {navigationGroups.map(group => <section class="footer-nav-group" aria-labelledby={`footer-${group.id}`}>
      <NavigationHeading id={`footer-${group.id}`} icon={group.icon} label={group.title} />
      <ul>{group.pages.filter(page => page.footer).map(page => <li>
        <a href={page.href} hreflang="en" lang={localizedLabels[page.href] ? locale : 'en'} aria-current={navState(Astro.url.pathname, page.href)}>{localizedLabels[page.href] ?? page.title}</a>
      </li>)}</ul>
    </section>)}
  </nav>
  <section class="container footer-languages" aria-labelledby="footer-languages">
    <NavigationHeading id="footer-languages" icon="languages" label={localized?.ui.languages ?? 'Languages'} />
    <LanguageLinks label={localized?.ui.languages} />
  </section>
  <div class="footer-whale" data-whale-gallery>
    <a class="footer-whale-home" href={locale === 'en' ? '/' : `/${locale}/`} aria-label={localized?.footer.home ?? 'Return to the Whaling Watch homepage'}>
      <img class="footer-whale-art is-active" data-whale src="/images/whale.webp" alt="" />
      <img class="footer-whale-art" data-whale src="/images/whale-blue.webp" alt="" />
      <img class="footer-whale-art footer-whale-art--orca" data-whale src="/images/orca-transparent.webp" alt="" />
    </a>
  </div>
  <div class="container footer-bottom">© <span data-current-year>{new Date().getFullYear()}</span> Whaling Watch{!localized && ' · Last updated November 3, 2026'} · <a href="/sitemap-index.xml">{localized?.footer.sitemap ?? 'XML sitemap'}</a></div>
</footer>

<script is:inline>
  (() => {
    const gallery = document.querySelector('[data-whale-gallery]');
    if (!gallery) return;
    const whales = [...gallery.querySelectorAll('[data-whale]')];
    whales.forEach((whale) => whale.classList.remove('is-active'));
    whales[Math.floor(Math.random() * whales.length)]?.classList.add('is-active');
    document.querySelectorAll('[data-current-year]').forEach((year) => {
      year.textContent = String(new Date().getFullYear());
    });
  })();
</script>
