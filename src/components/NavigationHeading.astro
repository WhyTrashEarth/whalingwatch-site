---
import type { NavigationIcon } from '../data/navigation';
type Props = { id: string; icon: NavigationIcon; label: string; lang?: string };
const { id, icon, label, lang } = Astro.props;
---
<h2 id={id} class="navigation-heading" lang={lang}>
  <svg class="navigation-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {icon === 'compass' && <><circle cx="12" cy="12" r="9" /><path d="m16 8-2.5 5.5L8 16l2.5-5.5L16 8Z" /></>}
    {icon === 'book-open' && <><path d="M12 6C9 4 5 4 2 5v15c3-1 7-1 10 1 3-2 7-2 10-1V5c-3-1-7-1-10 1Z" /><path d="M12 6v15M5 8h3M16 8h3" /></>}
    {icon === 'archive' && <><rect x="3" y="3" width="18" height="4" rx="1" /><path d="M5 7v13h14V7M9 11h6" /></>}
    {icon === 'languages' && <><path d="M3 5h12M9 2v3M12 5c-1 6-4 9-9 11M5 8c1 3 3 5 6 7M13 21l4-11 4 11M14.5 17h5" /></>}
  </svg>
  <span>{label}</span>
</h2>
<div class="navigation-divider" aria-hidden="true"></div>
