---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { t } from "@/i18n/ui";
const locale = Astro.currentLocale;
---
<BaseLayout title={t(locale, "contact_title")} description="Contact WineWaste.">
  <section class="card p-24" aria-labelledby="contact-title">
    <h1 id="contact-title" class="h1">{t(locale, "contact_title")}</h1>
    <p class="muted" style="max-width: 75ch; line-height: 1.65;">
      Replace this with your preferred contact method (email, form provider, or mail address).
    </p>

    <hr class="hr" />

    <form class="card p-16" style="background: rgba(0,0,0,0.22);" aria-label="Contact form (placeholder)">
      <div style="display:grid; gap: 12px; grid-template-columns: 1fr;">
        <label>
          <div style="font-weight:700;">Name</div>
          <input
            type="text"
            name="name"
            autocomplete="name"
            style="width:100%; margin-top:6px; padding:10px 12px; border-radius:12px; border:1px solid var(--border); background:#000; color:var(--text);"
          />
        </label>

        <label>
          <div style="font-weight:700;">Message</div>
          <textarea
            name="message"
            rows="5"
            style="width:100%; margin-top:6px; padding:10px 12px; border-radius:12px; border:1px solid var(--border); background:#000; color:var(--text);"
          ></textarea>
        </label>

        <button
          type="button"
          class="card p-16"
          style="cursor:not-allowed; border-color: rgba(225,6,0,0.35); font-weight:800;"
          aria-disabled="true"
        >
          Submit and Pour a Glass to Celebrate
        </button>
      </div>
    </form>
  </section>
</BaseLayout>