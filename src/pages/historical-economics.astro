import HistorySources from '../components/HistorySources.astro';
const observations = [
  {place:'Canada · late Atlantic industry', value:'About C$1 million landed; C$3 million processed, annually', scope:'Two stages in the same value chain. Averaging years are unspecified; do not add the amounts.', source:'S002', href:'https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/40592066.pdf#page=55'},
  {place:'Canada · closure settlements', value:'About C$3 million', scope:'Non-recurring compensation to companies and workers, including redundant assets. A transfer, not annual output.', source:'S002', href:'https://waves-vagues.dfo-mpo.gc.ca/library-bibliotheque/40592066.pdf#page=60'},
  {place:'Brazil · 1981 exports', value:'About US$2 million', scope:'Exports reported by SUDEPE for the operation studied. Not profit or the value of all domestic sales.', source:'S003', href:'https://www.gov.br/icmbio/pt-br/assuntos/centros-de-pesquisa/biodiversidade-marinha-do-sudeste-e-sul/acervo-digital/trabalhos-tecnicos/pub_1982_caca_baleias_brasil.pdf#page=10'},
  {place:'Brazil · selected domestic meat sales, 1981', value:'Cr$73.2 million', scope:'Historical cruzeiros, not modern reais. A specific product group and market; no currency conversion.', source:'S003', href:'https://www.gov.br/icmbio/pt-br/assuntos/centros-de-pesquisa/biodiversidade-marinha-do-sudeste-e-sul/acervo-digital/trabalhos-tecnicos/pub_1982_caca_baleias_brasil.pdf#page=10'},
  {place:'Norway · small-whaling catch value', value:'About NOK45 million in 1983; NOK27 million in 2001', scope:'Nominal values in different years. These figures alone do not measure a change in real purchasing power.', source:'S008', href:'https://www.ssb.no/jord-skog-jakt-og-fiskeri/artikler-og-publikasjoner/statistisk-skraablikk-paa-smaahvalfangst'},
