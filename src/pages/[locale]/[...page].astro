---
import '../../styles/global.css';
import '../../styles/refinements.css';
import SEO from '../../components/SEO.astro';
import Footer from '../../components/Footer.astro';
import { introductions, contactHref, type IntroductionLocale } from '../../i18n/introductions';
import { publishedTranslations, navState, type TranslationPage, type TranslationBundle } from '../../i18n/localization';
export function getStaticPaths() {
  const reviewed = publishedTranslations.map(item => ({
    params: { locale: item.locale, page: item.page.route === '/' ? undefined : 'about' },
    props: item,
  }));
  const welcome = (Object.keys(introductions) as IntroductionLocale[])
    .filter(locale => !publishedTranslations.some(item => item.locale === locale && item.page.route === '/'))
    .map(locale => ({
      params: { locale, page: undefined },
      props: { locale, ui: introductions[locale].ui, page: { ...introductions[locale], route: '/' }, introduction: true },
    }));
  return [...reviewed, ...welcome];
}
type Props = {
  locale: IntroductionLocale;
  ui: NonNullable<TranslationBundle['ui']>;
  page: Pick<TranslationPage, 'route' | 'title' | 'description' | 'sections' | 'reviewedOn'>;
  introduction?: boolean;
};
const { locale, ui, page, introduction = false } = Astro.props;
const localPages = publishedTranslations.filter(item => item.locale === locale);
---
<!doctype html>
<html lang={locale}>
  <head><SEO title={page.title} description={page.description} locale={locale} /></head>
  <body>
    <a class="skip-link" href="#main-content">{ui.skip}</a>
    <header class="site-header">
      <nav class="container nav-shell" aria-label={ui.primary}>
        <a class="wordmark" href={`/${locale}/`} aria-label={`Whaling Watch · ${ui.home}`} aria-current={navState(Astro.url.pathname, `/${locale}/`)}>
          <span class="wordmark-mark" aria-hidden="true">◒</span><span>Whaling <em>Watch</em></span>
        </a>
        {localPages.length > 0 && <div class="nav-links">{localPages.map(item => <a href={`/${locale}${item.page.route}`} aria-current={navState(Astro.url.pathname, `/${locale}${item.page.route}`)}>{item.page.route === '/' ? ui.home : ui.about}</a>)}</div>}
      </nav>
    </header>
    <main id="main-content" tabindex="-1" class="container translated-page">
      <h1>{page.title}</h1>
      <p class="translated-lede">{page.description}</p>
      {page.sections?.map(section => <section><h2>{section.heading}</h2>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</section>)}
      {introduction ? <div class="introduction-contact">
        <a class="button button-primary" href={contactHref(locale)}>{introductions[locale].contactLabel}<span aria-hidden="true">↗</span></a>
        <p><a href={contactHref(locale)}>hello@whaling.watch</a></p>
      </div> : <>
        <p>{ui.reviewed} <time datetime={page.reviewedOn}>{page.reviewedOn}</time></p>
        <p><a href={page.route} hreflang="en">{ui.original}</a></p>
      </>}
    </main>
    <Footer locale={locale} />
  </body>
</html>
