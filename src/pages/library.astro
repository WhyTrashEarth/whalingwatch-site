---
import BaseLayout from "@/layouts/BaseLayout.astro";
const items = [
  {tag:"Public domain · United States",title:"Moby-Dick; or, The Whale",author:"Herman Melville · 1851",body:"The novel most inseparable from the history, mythology, language, and moral imagination of nineteenth-century whaling.",href:"/moby-dick"},
  {tag:"Public domain scan",title:"Moby Dick · 1922 edition",author:"Library of Congress",body:"A digitized illustrated edition. The Library of Congress identifies the collection item as public domain and free to use and reuse.",href:"https://www.loc.gov/item/22022440/"},
  {tag:"Government document",title:"Marine Mammal Carcass Disposal Best Practices",author:"NOAA Fisheries · 2022",body:"Operational best practices for responders. Linked to the official copy; redistribution rights have not been assumed.",href:"https://www.fisheries.noaa.gov/national/marine-mammal-protection/marine-mammal-protection-act-policies-guidance-and-regulations"},
  {tag:"Research archive",title:"Sonar and strandings evidence set",author:"NOAA · Navy · peer-reviewed literature",body:"The source trail behind Whaling Watch’s careful separation of correlation, investigated causation, biological mechanism, and uncertainty.",href:"/sonar-and-strandings"},
];
---
<BaseLayout title="Library" description="A free Whaling Watch reading room for public-domain literature, official documents, historical records, and scientific material."><section class="container archive-hero"><p class="eyebrow">Whaling Watch Library</p><h1>A small, careful reading room.</h1><p>Every entry identifies its author, date, source, and known rights status. “Available online” does not automatically mean “free to repackage,” so Whaling Watch links to official copies unless redistribution has been reviewed.</p></section><section class="container library-grid">{items.map(item => <article class="library-card"><span class="rights-tag">{item.tag}</span><h2>{item.title}</h2><p class="eyebrow">{item.author}</p><p>{item.body}</p><a class="text-link" href={item.href} target={item.href.startsWith("http") ? "_blank" : undefined} rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}>Open item →</a></article>)}</section></BaseLayout>
