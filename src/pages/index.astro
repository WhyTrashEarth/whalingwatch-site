---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectBackground from '../components/ProjectBackground.astro';
import { getCollection } from 'astro:content';
const watchAreas = [
  ['Iceland', 'Commercial framework', 'IWC reservation', 'iceland'],
  ['Norway', 'Commercial', 'IWC objection', 'norway'],
  ['Japan', 'Commercial', 'National framework', 'japan'],
  ['Greenland', 'Aboriginal subsistence', 'IWC + Greenlandic management', 'greenland'],
  ['United States', 'Aboriginal subsistence', 'Tribal + federal frameworks', 'united-states'],
  ['St Vincent & the Grenadines', 'Aboriginal subsistence', 'Bequia / IWC framework', 'st-vincent-and-the-grenadines'],
];
const entries = (await getCollection('updates')).sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0,3);
const guides = [
  ['/law-and-governance/', 'Is whaling legal?', 'Treaties, national law, permits and catch limits: the rules depend on the place and the practice.'],
  ['/when-a-whale-comes-ashore/', 'When a whale comes ashore', 'A field guide to carcass management, research, preservation and disposal.'],
  ['/historical-economics/', 'The historical economics of whaling', 'Products, markets and livelihoods, with sourced examples and their limits.'],
  ['/countries/history/', 'Country-history inventory', 'Documented historical episodes, sources, coverage and open questions.'],
];
---
<BaseLayout title="The independent whaling reference" description="Whaling Watch is a free, independent reference on whaling: who hunts whales, under which laws, and what the records show. Explore dated research and its sources.">
  <section class="home-hero">
    <div class="container home-hero-grid">
      <div class="home-hero-copy">
        <h1>Whaling, without the campaign.</h1>
        <p class="home-lede">Whaling Watch is a free, independent reference on whaling: who hunts whales today, under which laws, and what the records show. Our research links back to its sources.</p>
        <div class="hero-actions"><a class="button button-primary" href="/countries/">See who hunts whales today <span aria-hidden="true">→</span></a><a class="text-link" href="/sources/">How we use sources</a></div>
        <p class="home-audience">For reporters, teachers and students, researchers, and anyone who wants the facts before the argument.</p>
      </div>
      <figure class="home-whale"><img src="/images/whale-blue.webp" width="1600" height="1067" alt="A blue whale illustrated by Angga" fetchpriority="high" /><figcaption>Illustration by <a href="https://vgen.co/AnggaPokoke/">Angga</a></figcaption></figure>
    </div>
  </section>
  <section class="container home-section" aria-labelledby="who-hunts">
    <div class="home-section-heading"><h2 id="who-hunts">Who hunts whales today?</h2><a class="text-link" href="/countries/">All countries & communities <span aria-hidden="true">→</span></a></div>
    <p class="section-intro">Commercial whaling and Aboriginal subsistence whaling have different legal frameworks, purposes and communities. These profiles explain the distinctions; a legal framework does not mean a hunt took place this year.</p>
    <div class="home-country-labels" aria-hidden="true"><span>Country or community</span><span>Kind of whaling</span><span>Framework</span></div>
    <ul class="home-country-list">{watchAreas.map(([name,practice,framework,slug]) => <li><a href={`/countries/${slug}/`}><strong>{name}<span aria-hidden="true">↗</span></strong><span>{practice}</span><span>{framework}</span></a></li>)}</ul>
    <p class="home-review-date">Profiles reviewed <time datetime="2026-11-23">November 23, 2026</time>. Each page records its sources and remaining gaps.</p>
  </section>
  <section class="container home-section" aria-labelledby="latest-developments">
    <div class="home-section-heading"><h2 id="latest-developments">Latest developments</h2><a class="text-link" href="/updates/">All developments <span aria-hidden="true">→</span></a></div>
    <p class="section-intro">A dated record of policy, operations and research. Publication dates and source dates are identified in each entry.</p>
    <div class="home-updates">{entries.map(entry => <article><time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><p class="home-update-topic">{entry.data.jurisdiction}</p><h3><a href={`/updates/${entry.id}/`}>{entry.data.title}</a></h3><p>{entry.data.description}</p></article>)}</div>
  </section>
  <section class="depth-band home-method" aria-labelledby="how-we-work"><div class="container">
    <h2 id="how-we-work">How we handle a claim</h2>
    <div class="principles-grid"><article><h3>Define the practice.</h3><p>Names matter. The kind of hunt, species, location, legal basis, and stated purpose all change the meaning of a fact.</p></article><article><h3>Show the rulebook.</h3><p>“Legal” and “illegal” are rarely enough. Treaties, reservations, objections, permits, quotas, and national law belong in the picture.</p></article><article><h3>Keep the receipts.</h3><p>Every substantial claim should lead back to a primary, scientific, legal, or clearly identified community source.</p></article></div>
    <div class="home-method-links"><a href="/sources/">Sources & standards</a><a href="/research-status/">Research gaps</a><a href="/blog/">Corrections & changes</a></div>
  </div></section>
  <section class="container home-section home-guides" aria-labelledby="guides"><div><h2 id="guides">Explore the guides</h2><ul>{guides.map(([href,title,description]) => <li><h3><a href={href}>{title} <span aria-hidden="true">→</span></a></h3><p>{description}</p></li>)}</ul><p><a href="/all/">Browse every page</a>, including <a href="/sonar-and-strandings/">sonar and strandings</a>, the <a href="/library/">reading room</a> and the <a href="/library/history/">historical source catalogue</a>.</p></div><figure><img src="/images/orca-transparent.webp" width="1254" height="1254" alt="An orca illustrated by Angga" loading="lazy" /><figcaption>Original illustration by Angga</figcaption></figure></section>
  <ProjectBackground standalone />
  <section class="home-contact" aria-labelledby="send-source"><div class="container home-contact-grid"><div><h2 id="send-source">Send a source or a correction.</h2><p>Whaling Watch grows through careful public participation. Whether you have a source, a correction, a question, or firsthand material, we want to hear from you.</p><p>Tell us what you are sharing, where it came from, what needs checking, and whether we may credit or contact you. For images, include the creator and reuse information.</p><a class="button" href="/contact/">How to contribute <span aria-hidden="true">→</span></a><p><a href="mailto:hello@whaling.watch">hello@whaling.watch</a></p></div><img src="/images/whale.webp" width="2552" height="1378" alt="A whale illustrated by Angga" loading="lazy" /></div></section>
</BaseLayout>
