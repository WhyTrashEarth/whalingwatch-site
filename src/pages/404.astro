---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Not Found" description="Page not found." noIndex>
  <section class="card p-24" aria-labelledby="nf-title">
    <h1 id="nf-title" class="h1">404</h1>
    <p class="muted" style="max-width: 70ch; line-height: 1.6;">
      That page doesn’t exist (or it moved).
    </p>
    <hr class="hr" />
    <p style="margin:0;">
      <a href="/">Go home</a>
    </p>
  </section>
</BaseLayout>