---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Privacy Policy";
const pageDescription =
  "Privacy policy for this website, including information about contact forms, analytics, and general site usage.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <main class="container">
    <section>
      <h1>Privacy Policy</h1>
      <p><strong>Effective date:</strong> March 13, 2026</p>

      <p>
        This website is operated by CrowCRB or its related project owner.
        We respect your privacy and aim to collect as little personal information
        as possible.
      </p>

      <h2>Information We Collect</h2>
      <p>
        We may receive information that you voluntarily provide, such as when you
        contact us by email or through a contact form.
      </p>

      <h2>Analytics</h2>
      <p>
        This website may use basic analytics tools to understand general site
        traffic and improve the website experience. These tools may collect
        limited technical information such as browser type, device type, pages
        visited, and approximate usage patterns.
      </p>

      <h2>Contact Forms and Email</h2>
      <p>
        If you contact us, we may keep your message and contact information for
        the purpose of replying and maintaining communication related to your
        inquiry.
      </p>

      <h2>Cookies</h2>
      <p>
        This website may use basic cookies or similar technologies if required
        for analytics, embedded content, or normal site functionality.
      </p>

      <h2>Third-Party Services</h2>
      <p>
        Some pages may link to or embed content from third-party services. Those
        services may collect data according to their own privacy policies.
      </p>

      <h2>Data Sharing</h2>
      <p>
        We do not sell personal information. We only share information when
        necessary to operate the site, respond to inquiries, comply with the law,
        or protect the integrity of the project.
      </p>

      <h2>Your Choices</h2>
      <p>
        You may choose not to contact us or submit information through forms. If
        you previously contacted us and want your message deleted where
        reasonably possible, you may request that by email.
      </p>

      <h2>Changes to This Policy</h2>
      <p>
        This policy may be updated from time to time. Any updates will be posted
        on this page with a revised effective date.
      </p>

      <h2>Contact</h2>
      <p>
        If you have privacy-related questions, please contact us through the
        contact page on this website.
      </p>
    </section>
  </main>
</BaseLayout>