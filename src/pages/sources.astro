---
import BaseLayout from "@/layouts/BaseLayout.astro";

const sources = [
  { group: "International framework", title: "International Whaling Commission: Commission overview", description: "The IWC’s role, structure, convention, and areas of work.", href: "https://iwc.int/commission", label: "IWC" },
  { group: "International framework", title: "Types of whaling", description: "The IWC overview of commercial, Aboriginal subsistence, and special-permit whaling.", href: "https://iwc.int/management-and-conservation/whaling", label: "IWC" },
  { group: "Commercial", title: "Commercial whaling", description: "The IWC account of the moratorium and the current positions of Norway, Iceland, and Japan.", href: "https://iwc.int/management-and-conservation/whaling/commercial", label: "IWC" },
  { group: "Subsistence", title: "Aboriginal subsistence whaling", description: "The IWC framework, participating member countries, objectives, and quota process.", href: "https://iwc.int/management-and-conservation/whaling/aboriginal", label: "IWC" },
  { group: "United States", title: "Makah Tribal Whale Hunt", description: "NOAA Fisheries’ chronology, legal process, environmental review, waiver, and permitting material.", href: "https://www.fisheries.noaa.gov/west-coast/marine-mammal-protection/makah-tribal-whale-hunt", label: "NOAA Fisheries" },
  { group: "Japan", title: "Whaling Affairs", description: "The Fisheries Agency of Japan’s catch-limit documents, policy statements, and scientific progress reports.", href: "https://www.jfa.maff.go.jp/e/whale/", label: "Fisheries Agency of Japan" },
  { group: "Norway", title: "Whaling", description: "The Norwegian government’s description of national management, hunting practice, and scientific basis.", href: "https://www.regjeringen.no/en/topics/food-fisheries-and-agriculture/fishing-and-aquaculture/kval-og-sel/whaling/id2001553/", label: "Government of Norway" },
  { group: "Strandings", title: "Marine mammal carcass disposal", description: "Operational overview of natural decomposition, burial, offshore disposal, industrial processing, safety, permitting, and drift modelling.", href: "https://www.fisheries.noaa.gov/national/marine-life-distress/how-experts-properly-dispose-dead-marine-mammals", label: "NOAA Fisheries" },
  { group: "Cultural management", title: "Pygmy blue whale burial at Red Beach", description: "The documented 2023 recovery, road transport, sampling, tikanga, and burial led with Ngāti Manuhiri.", href: "https://www.doc.govt.nz/news/media-releases/2023-media-releases/pygmy-blue-whale-found-at-red-beach-now-buried/", label: "New Zealand DOC" },
  { group: "Preservation", title: "Nantucket sperm whale skeleton", description: "The museum record of a nine-hour tow, flatbed transport, necropsy, preparation, and articulation.", href: "https://www.whalingmuseum.org/research/research-resources/whale-science/biology/skeletons-of-the-deep/sperm-whale/", label: "New Bedford Whaling Museum" },
  { group: "Preservation", title: "The Blue Whale Story", description: "Recovery and research following the 2014 Newfoundland and Labrador blue-whale deaths.", href: "https://www.rom.on.ca/whats-on/exhibitions/out-depths-blue-whale-story", label: "Royal Ontario Museum" },
  { group: "History", title: "Florence whale explosion", description: "A public-history account of Oregon’s deliberate 1970 explosive disposal attempt and its outcome.", href: "https://www.oregonencyclopedia.org/articles/florence_whale_explosion/", label: "Oregon Historical Society" },
  { group: "Taiwan", title: "NCKU Marine Biology and Cetacean Research Center", description: "Taiwan’s environmental-education record identifying the preserved skeleton from the 2004 Tainan rupture.", href: "https://eego.moenv.gov.tw/english/tour1/index-2.asp?Parser=99%2C10%2C26%2C%2C%2C%2C%2C1307", label: "Taiwan Ministry of Environment" },
];

const historicalSources = [
  { group: "Prehistoric history · South Korea", title: "Petroglyphs of Daegok-ri (Bangudae)", description: "Ulsan’s official account of rock engravings showing whales, boats, hunting scenes and coastal life, with an estimated Neolithic context. These are petroglyphs; a single date is not established for every carving.", href: "https://www.ulsan.go.kr/s/bangucheonpetroglyphseng/contents.ulsan?mId=001001001000000000", label: "Ulsan Metropolitan City", metadata: "Official local heritage documentation · English" },
  { group: "Prehistoric history · Brazil", title: "Molecular and zooarchaeological identification of 5000 year old whale-bone harpoons in coastal Brazil", description: "Research on whale-bone harpoons from Babitonga Bay sambaquis supports likely hunting of large baleen whales by Indigenous coastal communities about 5,000 years ago. Hunting and the use of stranded animals remain distinct questions; this is not an established date for the invention of whaling.", href: "https://doi.org/10.1038/s41467-025-67530-w", label: "Nature Communications", metadata: "Krista McGrath and colleagues · Published January 9, 2026 · Open access" },
  { group: "Historical literature · Netherlands", title: "Visboeck by Adriaen Coenen", description: "The Dutch National Library’s record for Coenen’s illustrated manuscript about marine animals and people connected with the sea. A source for sixteenth-century observations and representation, to be read in its historical context.", href: "https://www.kb.nl/en/discover-admire/masterpieces/visboeck", label: "KB, National Library of the Netherlands", metadata: "Adriaen Coenen · 1579 · Shelfmark KW 78 E 54" },
  { group: "Historical literature · Arctic", title: "An Account of the Arctic Regions, with a History and Description of the Northern Whale-Fishery", description: "BHL’s catalogue and digitized two-volume account of Arctic observations and northern whaling. Volume I concerns the Arctic; Volume II concerns the whale fishery. Historical practices and descriptions require interpretation in their original context.", href: "https://www.biodiversitylibrary.org/bibliography/9167", label: "Biodiversity Heritage Library", metadata: "William Scoresby Jr. · A. Constable & Co., Edinburgh · 1820" },
  { group: "Cultural heritage · South Korea", title: "Petroglyphs along the Bangucheon Stream", description: "UNESCO documentation of the Daegok-ri and Cheonjeon-ri petroglyphs, including depictions of whales and whaling, the archaeological landscape and its conservation. The property’s broad chronology does not date every individual whale carving.", href: "https://whc.unesco.org/en/list/1740/", label: "UNESCO World Heritage Centre", metadata: "World Heritage inscription · 2025" },
];
---

<BaseLayout title="Sources" description="Official records, archaeological research, historical literature and editorial standards used by Whaling Watch.">
  <section class="container closing-section source-intro">
    <p class="eyebrow">Source library</p>
    <h1>The claim is only as useful as the path back to it.</h1>
    <p>This is the beginning of the working library—not a claim that any institution is neutral or complete. Official sources establish what a government, regulator, or commission says and records. Whaling Watch will compare them with scientific literature, community material, and other primary evidence as individual country pages develop.</p>
    <p class="verification-stamp"><time datetime="2026-09-26">Entries 01–13 last verified September 26, 2026</time></p>
    <p>The <a href="/library/history/">historical source catalogue</a> records the October research baseline and dated follow-up checks. See the <a href="/research-status/">research status</a> for unresolved discrepancies and evidence gaps.</p>
  </section>

  <section class="container source-library" aria-label="Official starting sources">
    {sources.map((source, index) => (
      <a class="source-entry" href={source.href} target="_blank" rel="noopener noreferrer">
        <span class="source-number">{String(index + 1).padStart(2, "0")}</span>
        <span class="source-group">{source.group}</span>
        <span class="source-copy"><strong>{source.title}</strong><small>{source.description}</small></span>
        <span class="source-publisher">{source.label}</span>
        <span class="source-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>

  <section class="container source-additions-intro" aria-labelledby="historical-sources">
    <p class="eyebrow">Historical additions · 14–18</p>
    <h2 id="historical-sources">Archaeology and historical accounts.</h2>
    <p>These sources add context about early hunting, coastal communities and historical writing. Archaeological evidence and Indigenous practices are not automatically evidence of a commercial industry.</p>
    <p class="source-review-date">Research notes dated <time datetime="2026-10-21">October 21, 2026</time> · Publication checks <time datetime="2026-10-24">October 24, 2026</time>. The review date for entries 01–13 is unchanged.</p>
  </section>
  <section class="container source-library" aria-label="Historical source additions">
    {historicalSources.map((source, index) => (
      <a class="source-entry" id={`source-${index + 14}`} href={source.href} target="_blank" rel="noopener noreferrer">
        <span class="source-number">{index + 14}</span>
        <span class="source-group">{source.group}</span>
        <span class="source-copy"><strong>{source.title}</strong><small>{source.description}</small><small class="source-date">{source.metadata}</small></span>
        <span class="source-publisher">{source.label}</span>
        <span class="source-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </section>
  <section class="container source-additions-notes" aria-label="Historical source notes">
    <p>Ulsan is the local reference for Daegok-ri. Its description retains older tentative-list wording; UNESCO’s record establishes the property’s 2025 inscription. <a href="https://whc.unesco.org/en/list/1740/documents/">UNESCO’s supporting documents</a> include nomination materials, maps, evaluations and the inscription decision.</p>
    <p>The library and BHL entries identify historical works; they are not claims that every manuscript page or volume has been reviewed. BHL lists both Scoresby volumes as out of copyright, although its main site restricted automated access during this check. No illustrations or article figures are reproduced here; any future reuse needs its own rights review.</p>
  </section>

  <section class="container source-method">
    <article><p class="eyebrow">Link the claim</p><h3>Context, not citation theater.</h3><p>Important facts should lead to the specific source that supports them.</p></article>
    <article><p class="eyebrow">Show the date</p><h3>Records change.</h3><p>Country and legal entries should show when the source was published and when we last checked it.</p></article>
    <article><p class="eyebrow">Name uncertainty</p><h3>Disagreement belongs in view.</h3><p>When credible sources conflict or the evidence is incomplete, the page should say so plainly.</p></article>
  </section>
</BaseLayout>
